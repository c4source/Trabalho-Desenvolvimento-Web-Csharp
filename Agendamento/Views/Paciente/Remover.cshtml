@model Agendamento.Models.Paciente

@{
    ViewData["Title"] = "Remover Paciente";
}

<h1>Remover</h1>

<h3>Tem certeza de que deseja remover este paciente?</h3>

<div>

    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Nome
        </dt>

        <dd class="col-sm-10">
            @Model.Nome
        </dd>

        <dt class="col-sm-2">
            CPF
        </dt>

        <dd class="col-sm-10">
            @Model.Cpf
        </dd>

        <dt class="col-sm-2">
            Telefone
        </dt>

        <dd class="col-sm-10">
            @Model.Telefone
        </dd>

        <dt class="col-sm-2">
            Endereço
        </dt>

        <dd class="col-sm-10">
            @Model.Endereco
        </dd>

        <dt class="col-sm-2">
            Data de nascimento
        </dt>

        <dd class="col-sm-10">
            @(Model.DataNascimento?.ToString("dd/MM/yyyy"))
        </dd>

    </dl>

    <form asp-action="Deletar">

        <input type="hidden" asp-for="Id" />

        <input type="submit"
               value="Remover"
               class="btn btn-outline-danger" />

        <a asp-action="Index"
           class="btn btn-outline-info">
            Voltar
        </a>

    </form>

    <hr />

</div>